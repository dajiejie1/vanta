FROM quay.io/fedora/fedora-bootc:45

ARG VANTA_IMAGE=ghcr.io/dajiejie1/vanta:latest

# Fedora 45 Anaconda live environment. The installed desktop remains Vanta.
RUN dnf5 install -qy \
    anaconda anaconda-install-img-deps anaconda-dracut \
    dracut-config-generic dracut-network net-tools \
    grub2-efi-x64-cdboot plymouth \
    default-fonts-core-sans default-fonts-other-sans google-noto-sans-cjk-fonts \
    xorrisofs squashfs-tools jq && dnf5 clean all

RUN mkdir -p /boot/efi /usr/lib/image-builder/bootc \
    /usr/lib/systemd/logind.conf.d \
    /etc/systemd/user/pipewire.service.d \
    /etc/systemd/user/pipewire.socket.d \
    && cp -ra /usr/lib/efi/*/*/EFI /boot/efi

COPY installer/iso.yaml /usr/lib/image-builder/bootc/iso.yaml
COPY installer/logind.conf /usr/lib/systemd/logind.conf.d/anaconda-shell.conf
COPY installer/pipewire.service.conf /etc/systemd/user/pipewire.service.d/allowroot.conf
COPY installer/pipewire.socket.conf /etc/systemd/user/pipewire.socket.d/allowroot.conf

# Anaconda fetches the public Vanta image during installation.
RUN printf 'bootc --source-imgref registry:%s --target-imgref %s\n' \
    "$VANTA_IMAGE" "$VANTA_IMAGE" > /usr/share/anaconda/interactive-defaults.ks

RUN printf 'install:x:0:0:root:/root:/usr/libexec/anaconda/run-anaconda\n' >> /etc/passwd \
    && printf 'install::14438:0:99999:7:::\n' >> /etc/shadow \
    && passwd -d root

RUN mv /usr/share/anaconda/list-harddrives-stub /usr/bin/list-harddrives \
    && mv /usr/share/dnf5/repos.d /etc/anaconda.repos.d \
    && ln -s /lib/systemd/system/anaconda.target /etc/systemd/system/default.target \
    && rm -f /usr/lib/systemd/system-generators/systemd-gpt-auto-generator \
    && ln -s /usr/lib/systemd/system/anaconda-shell@.service \
       /usr/lib/systemd/system/autovt@.service

RUN mkdir -p "$(realpath /root)" \
    && kernel="$(kernel-install list --json pretty | jq -r '.[] | select(.has_kernel == true) | .version' | head -n 1)" \
    && test -n "$kernel" \
    && DRACUT_NO_XATTR=1 dracut --force --zstd --reproducible --no-hostonly \
       --add "anaconda" "/usr/lib/modules/${kernel}/initramfs.img" "$kernel"
